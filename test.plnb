   "source": [
    "import torch\n",
    "import torch.nn as nn\n",
    "import numpy as np\n",
    "\n",
    "class NavierStokesPINN(nn.Module):\n",
    "    def __init__(self):\n",
    "        super(NavierStokesPINN, self).__init__()\n",
    "        # Input: x, y, t | Output: u, v, p\n",
    "        self.net = nn.Sequential(\n",
    "            nn.Linear(3, 50), nn.Tanh(),\n",
    "            nn.Linear(50, 50), nn.Tanh(),\n",
    "            nn.Linear(50, 50), nn.Tanh(),\n",
    "            nn.Linear(50, 3)\n",
    "        )\n",
    "\n",
    "    def forward(self, x, y, t):\n",
    "        inputs = torch.cat([x, y, t], dim=1)\n",
    "        out = self.net(inputs)\n",
    "        u = out[:, 0:1]\n",
    "        v = out[:, 1:2]\n",
    "        p = out[:, 2:3]\n",
    "        return u, v, p\n",
    "\n",
    "def navier_stokes_loss(model, x, y, t, nu=0.01):\n",
    "    \"\"\"\n",
    "    Computes the residual loss for the Navier-Stokes equations:\n",
    "    u_t + (u.grad)u = -grad(p) + nu*laplacian(u)\n",
    "    div(u) = 0\n",
    "    \"\"\"\n",
    "    x.requires_grad_(True)\n",
    "    y.requires_grad_(True)\n",
    "    t.requires_grad_(True)\n",
    "\n",
    "    u, v, p = model(x, y, t)\n",
    "\n",
    "    # Derivatives for u\n",
    "    u_t = torch.autograd.grad(u, t, torch.ones_like(u), create_graph=True)[0]\n",
    "    u_x = torch.autograd.grad(u, x, torch.ones_like(u), create_graph=True)[0]\n",
    "    u_y = torch.autograd.grad(u, y, torch.ones_like(u), create_graph=True)[0]\n",
    "    u_xx = torch.autograd.grad(u_x, x, torch.ones_like(u_x), create_graph=True)[0]\n",
    "    u_yy = torch.autograd.grad(u_y, y, torch.ones_like(u_y), create_graph=True)[0]\n",
    "\n",
    "    # Derivatives for v\n",
    "    v_t = torch.autograd.grad(v, t, torch.ones_like(v), create_graph=True)[0]\n",
    "    v_x = torch.autograd.grad(v, x, torch.ones_like(v), create_graph=True)[0]\n",
    "    v_y = torch.autograd.grad(v, y, torch.ones_like(v), create_graph=True)[0]\n",
    "    v_xx = torch.autograd.grad(v_x, x, torch.ones_like(v_x), create_graph=True)[0]\n",
    "    v_yy = torch.autograd.grad(v_y, y, torch.ones_like(v_y), create_graph=True)[0]\n",
    "\n",
    "    # Derivatives for p\n",
    "    p_x = torch.autograd.grad(p, x, torch.ones_like(p), create_graph=True)[0]\n",
    "    p_y = torch.autograd.grad(p, y, torch.ones_like(p), create_graph=True)[0]\n",
    "\n",
    "    # Residuals\n",
    "    f_u = u_t + u*u_x + v*u_y + p_x - nu*(u_xx + u_yy)\n",
    "    f_v = v_t + u*v_x + v*v_y + p_y - nu*(v_xx + v_yy)\n",
    "    f_mass = u_x + v_y\n",
    "\n",
    "    loss_pde = torch.mean(f_u**2 + f_v**2 + f_mass**2)\n",
    "    return loss_pde\n",
    "\n",
    "# Initialization and dummy data training step\n",
    "pinn = NavierStokesPINN()\n",
    "optimizer = torch.optim.Adam(pinn.parameters(), lr=1e-3)\n",
    "\n",
    "# Random collocation points in domain [0,1]x[0,1] for t in [0,1]\n",
    "x_col = torch.rand(100, 1)\n",
    "y_col = torch.rand(100, 1)\n",
    "t_col = torch.rand(100, 1)\n",
    "\n",
    "# Optimization step\n",
    "optimizer.zero_grad()\n",
    "loss = navier_stokes_loss(pinn, x_col, y_col, t_col)\n",
    "loss.backward()\n",
    "optimizer.step()\n",
    "\n",
    "print(f\"Simple PINN initialized. Initial PDE Residual Loss: {loss.item():.6f}\")"
   ]
  },
