          "text": "Sample football dataset:\n         date home_team away_team  home_score  away_score tournament    city country  neutral\n0  2023-01-01     Italy     Spain           2           1   Friendly    Rome   Italy    False\n1  2023-01-02     Italy    France           3           0   Friendly   Milan   Italy    False\n2  2023-01-03     Spain     Italy           1           0   Friendly  Madrid   Spain    False\n3  2023-01-04    France     Spain           2           1   Friendly   Paris  France    False\n"
         }
        ],
        "source": "import pandas as pd\n\n# Setup a small, controlled dataset for testing\n# This dataset is designed to specifically test the logic of the target cell:\n# - Italy: Plays more games at home (2) than away (1).\n# - Spain: Plays more games away (2) than at home (1).\n# - Italy: Wins more games at home (2) than away (0).\ndata = {\n    'date': ['2023-01-01', '2023-01-02', '2023-01-03', '2023-01-04'],\n    'home_team': ['Italy', 'Italy', 'Spain', 'France'],\n    'away_team': ['Spain', 'France', 'Italy', 'Spain'],\n    'home_score': [2, 3, 1, 2],\n    'away_score': [1, 0, 0, 1],\n    'tournament': ['Friendly'] * 4,\n    'city': ['Rome', 'Milan', 'Madrid', 'Paris'],\n    'country': ['Italy', 'Italy', 'Spain', 'France'],\n    'neutral': [False, False, False, False]\n}\n\ndf = pd.DataFrame(data)\n\nprint(\"Sample football dataset:\")\nprint(df.to_string())"
       },
       "target": {
        "outputs": [
