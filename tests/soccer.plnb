      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.colors as mcolors\n",
    "\n",
    "# Filter countries that have played at least 100 matches\n",
    "filtered_countries = country_stats[country_stats['total_matches'] >= 100].copy()\n",
    "\n",
    "# Calculate win fractions for home and away matches\n",
    "filtered_countries['win_home_fraction'] = filtered_countries['wins_home'] / filtered_countries['total_matches_home']\n",
    "filtered_countries['win_away_fraction'] = filtered_countries['wins_away'] / filtered_countries['total_matches_away']\n",
    "\n",
    "# Calculate the difference between home and away win fractions for coloring\n",
    "filtered_countries['win_diff'] = filtered_countries['win_home_fraction'] - filtered_countries['win_away_fraction']\n",
    "\n",
    "# Custom colormap: green (away advantage) -> gray (equal) -> red (home advantage)\n",
    "cmap_name = 'home_away_cmap'\n",
    "cm = mcolors.LinearSegmentedColormap.from_list(cmap_name, [\"green\", \"gray\", \"red\"], N=256)\n",
    "\n",
    "plt.figure(figsize=(10, 8))\n",
    "scatter = plt.scatter(\n",
    "    filtered_countries['win_away_fraction'],\n",
    "    filtered_countries['win_home_fraction'],\n",
    "    c=filtered_countries['win_diff'],\n",
    "    cmap=cm,\n",
    "    vmin=-1,\n",
    "    vmax=1,\n",
    "    s=80,\n",
    "    alpha=0.8,\n",
    "    edgecolors='w',\n",
    "    linewidths=0.5\n",
    ")\n",
    "\n",
    "plt.plot([0, 1], [0, 1], 'k--', alpha=0.5, label='Home Win % = Away Win %')\n",
    "\n",
    "plt.title('Home Win Fraction vs. Away Win Fraction (Countries with >= 100 Matches)', fontsize=14)\n",
    "plt.xlabel('Win Away Fraction', fontsize=12)\n",
    "plt.ylabel('Win Home Fraction', fontsize=12)\n",
    "plt.xlim(-0.05, 1.05)\n",
    "plt.ylim(-0.05, 1.05)\n",
    "plt.grid(True, linestyle='--', alpha=0.5)\n",
    "\n",
    "cbar = plt.colorbar(scatter)\n",
    "cbar.set_label('Home Win Fraction - Away Win Fraction', fontsize=11)\n",
    "cbar.set_ticks([-1, 0, 1])\n",
    "cbar.set_ticklabels(['More likely to win away', 'Equally likely', 'More likely to win at home'])\n",
    "\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
