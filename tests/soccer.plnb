   ],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Merge goals data with country stats to allow filtering by number of matches played\n",
    "merged_goal_fraction = pd.merge(country_stats, country_goals, on='country', how='inner')\n",
    "\n",
    "# Filter countries that have played at least 100 matches, consistent with the previous scatterplot\n",
    "filtered_goal_fraction = merged_goal_fraction[merged_goal_fraction['total_matches'] >= 100].copy()\n",
    "\n",
    "# Calculate the total goals scored (home + away) for each country\n",
    "filtered_goal_fraction['total_goals_scored'] = (\n",
    "    filtered_goal_fraction['goals_scored_home'] + filtered_goal_fraction['goals_scored_away']\n",
    ")\n",
    "\n",
    "# Calculate the fraction of goals scored at home and away out of total goals scored\n",
    "filtered_goal_fraction['goal_home_fraction'] = (\n",
    "    filtered_goal_fraction['goals_scored_home'] / filtered_goal_fraction['total_goals_scored']\n",
    ")\n",
    "filtered_goal_fraction['goal_away_fraction'] = (\n",
    "    filtered_goal_fraction['goals_scored_away'] / filtered_goal_fraction['total_goals_scored']\n",
    ")\n",
    "\n",
    "# Calculate the difference between home and away goal fractions for coloring\n",
    "filtered_goal_fraction['goal_fraction_diff'] = (\n",
    "    filtered_goal_fraction['goal_home_fraction'] - filtered_goal_fraction['goal_away_fraction']\n",
    ")\n",
    "\n",
    "# Create the scatterplot, reusing the custom colormap defined earlier (green: away, gray: equal, red: home)\n",
    "plt.figure(figsize=(10, 8))\n",
    "scatter_goal_fraction = plt.scatter(\n",
    "    filtered_goal_fraction['goal_away_fraction'],\n",
    "    filtered_goal_fraction['goal_home_fraction'],\n",
    "    c=filtered_goal_fraction['goal_fraction_diff'],\n",
    "    cmap=cm,\n",
    "    vmin=-1,\n",
    "    vmax=1,\n",
    "    s=80,\n",
    "    alpha=0.8,\n",
    "    edgecolors='w',\n",
    "    linewidths=0.5\n",
    ")\n",
    "\n",
    "plt.plot([0, 1], [0, 1], 'k--', alpha=0.5, label='Home Goal Fraction = Away Goal Fraction')\n",
    "\n",
    "plt.title('Fraction of Goals Scored at Home vs. Away (Countries with >= 100 Matches)', fontsize=14)\n",
    "plt.xlabel('Fraction of Goals Scored Away', fontsize=12)\n",
    "plt.ylabel('Fraction of Goals Scored Home', fontsize=12)\n",
    "plt.xlim(-0.05, 1.05)\n",
    "plt.ylim(-0.05, 1.05)\n",
    "plt.grid(True, linestyle='--', alpha=0.5)\n",
    "\n",
    "cbar_goal_fraction = plt.colorbar(scatter_goal_fraction)\n",
    "cbar_goal_fraction.set_label('Home Goal Fraction - Away Goal Fraction', fontsize=11)\n",
    "cbar_goal_fraction.set_ticks([-1, 0, 1])\n",
    "cbar_goal_fraction.set_ticklabels(['More goals away', 'Equally split', 'More goals home'])\n",
    "\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  }
 ],
