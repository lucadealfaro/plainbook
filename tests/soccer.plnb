        "source": "import pandas as pd\n\ndf = pd.DataFrame({\n    'date': ['2020-01-01', '2020-01-02', '2020-01-03', '2020-01-04', '2020-01-05', '2020-01-06'],\n    'home_team': ['A', 'B', 'A', 'C', 'B', 'A'],\n    'away_team': ['B', 'A', 'C', 'A', 'C', 'B'],\n    'home_score': [2, 1, 0, 3, 2, 1],\n    'away_score': [1, 1, 0, 2, 2, 1],\n    'tournament': ['Friendly'] * 6,\n    'city': ['CityX'] * 6,\n    'country': ['CountryX'] * 6,\n    'neutral': [False, False, True, False, True, False]\n})\n\ndf"
